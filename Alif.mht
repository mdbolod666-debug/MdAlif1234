#orView { padding-left: 10px; padding-right: 10px; padding-bottom: 130px; }

.or-top { display: flex; align-items: center; gap: 16px; margin-top: 18px; }

.or-menu { width: 46px; height: 46px; border-radius: 15px; border: 1px solid var(--bd); background: rgb(255, 255, 255); color: var(--tx); display: grid; place-items: center; font-size: 24px; cursor: pointer; box-shadow: rgba(20, 40, 90, 0.2) 0px 4px 12px -6px; flex-shrink: 0; }

.or-menu:active { transform: scale(0.95); }

.or-top h1 { font-size: 26px; font-weight: 800; letter-spacing: -0.6px; }

.or-list { display: grid; gap: 14px; margin-top: 16px; }

.or-card { border-radius: 22px; background: rgb(255, 255, 255); border: 1px solid var(--bd); box-shadow: rgba(20, 40, 90, 0.3) 0px 8px 22px -14px; padding: 16px 16px 14px; }

.or-hd { display: flex; align-items: center; gap: 12px; }

.or-ico { width: 42px; height: 42px; border-radius: 14px; background: rgb(232, 240, 255); color: var(--v); display: grid; place-items: center; font-size: 21px; flex-shrink: 0; }

.or-id { flex: 1 1 0%; min-width: 0px; font-size: 17px; font-weight: 800; letter-spacing: -0.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.or-st { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: 99px; font-size: 13px; font-weight: 700; flex-shrink: 0; background: rgb(227, 249, 236); color: rgb(6, 118, 71); }

.or-st svg { font-size: 15px; stroke-width: 2.4; }

.or-st.pending { background: rgb(255, 244, 220); color: rgb(180, 83, 9); }

.or-st.cancelled { background: rgb(254, 228, 226); color: rgb(180, 35, 24); }

.or-dates { display: grid; grid-template-columns: 1fr 1fr; margin-top: 14px; }

.or-dt { display: flex; align-items: center; gap: 10px; min-width: 0px; }

.or-dt + .or-dt { padding-left: 12px; border-left: 1px solid var(--bd); }

.or-dt .di { width: 38px; height: 38px; border-radius: 12px; border: 1px solid var(--bd); background: rgb(255, 255, 255); color: var(--v); display: grid; place-items: center; font-size: 19px; flex-shrink: 0; }

.or-dt small { display: block; font-size: 11.5px; font-weight: 700; color: var(--tx); }

.or-dt b { display: block; margin-top: 1px; font-size: 12.5px; font-weight: 800; color: var(--tx); }

.or-dt span { display: block; margin-top: 1px; font-size: 11.5px; font-weight: 500; color: var(--mu); }

.or-rows { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--bd); display: grid; gap: 11px; }

.or-row { display: flex; align-items: center; gap: 10px; font-size: 14px; }

.or-row svg { font-size: 20px; color: rgb(100, 116, 139); flex-shrink: 0; }

.or-row span { color: var(--mu); font-weight: 500; }

.or-row b { margin-left: auto; text-align: right; font-weight: 800; color: var(--tx); word-break: break-word; }

.or-empty { display: flex; flex-direction: column; align-items: center; text-align: center; margin-top: 16px; padding: 46px 20px; border-radius: 22px; background: rgb(255, 255, 255); border: 1px dashed rgb(183, 205, 251); }

.or-empty .eic { width: 68px; height: 68px; border-radius: 50%; background: rgb(232, 240, 255); color: var(--v); display: grid; place-items: center; font-size: 32px; }

.or-empty h3 { margin-top: 14px; font-size: 17px; font-weight: 800; }

.or-empty p { margin-top: 5px; font-size: 13px; color: var(--mu); line-height: 1.7; }

#cdView { padding-left: 10px; padding-right: 10px; padding-bottom: 130px; }

.cd-top { display: flex; align-items: center; gap: 14px; margin-top: 18px; }

.cd-top h1 { font-size: 26px; font-weight: 800; letter-spacing: -0.6px; flex: 1 1 0%; min-width: 0px; }

.cd-redeem { display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border: 0px; border-radius: 99px; background: var(--g); color: rgb(255, 255, 255); font-family: inherit; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: rgba(37, 99, 235, 0.85) 0px 10px 22px -10px; flex-shrink: 0; }

.cd-redeem svg { font-size: 17px; stroke-width: 2.2; }

.cd-redeem:active { transform: scale(0.97); }

.cd-list { display: grid; gap: 12px; margin-top: 16px; }

.cd-card { padding: 14px 16px; border-radius: 18px; background: rgb(255, 255, 255); border: 1px solid var(--bd); box-shadow: rgba(20, 40, 90, 0.3) 0px 8px 22px -14px; }

.cd-card b { display: block; font-size: 15px; font-weight: 800; }

.cd-card code { display: block; margin-top: 6px; font-size: 14px; font-weight: 700; letter-spacing: 0.5px; color: var(--v); word-break: break-all; }

.cd-empty { display: flex; flex-direction: column; align-items: center; text-align: center; margin-top: 16px; padding: 40px 20px; border-radius: 30px; background: rgb(255, 255, 255); border: 1px solid var(--bd); box-shadow: rgba(20, 40, 90, 0.25) 0px 8px 22px -14px; }

.cd-empty h3 { font-size: 20px; font-weight: 600; color: rgb(43, 51, 69); }

.cd-empty .cd-order { display: inline-flex; align-items: center; justify-content: center; margin-top: 22px; padding: 14px 34px; border-radius: 99px; background: var(--g); color: rgb(255, 255, 255); font-size: 17px; font-weight: 700; letter-spacing: 0.3px; box-shadow: rgba(37, 99, 235, 0.85) 0px 10px 22px -10px; }

.cd-empty .cd-order:active { transform: scale(0.97); }

#ctView { padding-left: 10px; padding-right: 10px; padding-bottom: 130px; }

.ct-hero { position: relative; margin-top: 16px; padding: 30px 20px 26px; border-radius: 30px; text-align: center; color: rgb(255, 255, 255); overflow: hidden; background: linear-gradient(135deg, rgb(96, 165, 250) 0%, rgb(37, 99, 235) 52%, rgb(30, 58, 138) 100%); box-shadow: rgba(37, 99, 235, 0.8) 0px 22px 44px -22px; }

.ct-hero::before, .ct-hero::after { content: ""; position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.12); }

.ct-hero::before { width: 190px; height: 190px; right: -60px; top: -90px; }

.ct-hero::after { width: 130px; height: 130px; left: -45px; bottom: -75px; background: rgba(255, 255, 255, 0.09); }

