.how { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; padding: 4px 2px; font-size: 14px; font-weight: 700; color: var(--v); }

.how svg { font-size: 18px; flex-shrink: 0; }

.how .ar { font-size: 17px; stroke-width: 2.4; }

.how:active { opacity: 0.7; }

.bal { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 13px; color: var(--mu); }

.bal > svg { font-size: 20px; flex-shrink: 0; }

.bal b { color: var(--v); font-size: 15px; margin-left: 4px; font-weight: 800; }

.bal em { font-style: normal; }

.bal .rf { margin-left: 4px; width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--bd); background: rgb(255, 255, 255); color: var(--v); display: grid; place-items: center; font-size: 17px; cursor: pointer; flex-shrink: 0; transition: 0.2s; }

.bal .rf:active { transform: scale(0.92); }

.bal .rf.spin svg { animation: 0.6s linear 0s 1 normal none running rfs; }

@keyframes rfs { 
  100% { transform: rotate(360deg); }
}

.hint.need { margin-top: 10px; }

.hint.need b { font-weight: 800; }

.pv-head.rh svg { font-size: 22px; color: var(--v); flex-shrink: 0; }

.rl { list-style: none; display: grid; gap: 9px; }

.rl li { position: relative; padding-left: 18px; font-size: 13px; line-height: 1.75; color: var(--mu); }

.rl li::before { content: ""; position: absolute; left: 2px; top: 10px; width: 6px; height: 6px; border-radius: 50%; background: var(--v2); }

html, body, .pk, .po, .btn, .pay, .q, .card, .nav a, .pv-back { touch-action: manipulation; }

.pk, .po { user-select: none; }

#uidPkGrid { gap: 8px; margin: -3px; }

#uidView .pk { min-height: 64px; padding: 8px 6px; gap: 3px; justify-content: center; border-radius: 12px; border-width: 1.5px; box-shadow: rgba(20, 40, 90, 0.25) 0px 2px 6px -4px; }

#uidView .pk span { font-size: 14.5px; font-weight: 700; line-height: 1.3; color: rgb(15, 31, 77); letter-spacing: -0.1px; }

#uidView .pk b { font-size: 13px; font-weight: 700; line-height: 1.3; color: var(--v); }

#uidView .pk.on { background: linear-gradient(160deg, rgb(239, 245, 255), rgb(255, 255, 255)); box-shadow: rgba(37, 99, 235, 0.15) 0px 0px 0px 3px, rgba(37, 99, 235, 0.7) 0px 8px 16px -10px; }

#uidView .pk.on::after { top: -7px; right: -5px; }

#uidView .pk span, #uidView .pk b { pointer-events: none; }

#uidView .pk:active { transform: none; background: rgb(239, 245, 255); }

#uidView .pk { appearance: none; font-family: inherit; }

