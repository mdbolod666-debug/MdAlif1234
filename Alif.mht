* { box-sizing: border-box; margin: 0px; padding: 0px; -webkit-tap-highlight-color: transparent; }

html { scroll-behavior: smooth; scrollbar-width: thin; scrollbar-color: rgb(37, 99, 235) rgb(240, 245, 255); }

::-webkit-scrollbar { width: 6px; height: 6px; }

::-webkit-scrollbar-track { background: rgb(240, 245, 255); }

::-webkit-scrollbar-thumb { background: linear-gradient(rgb(59, 130, 246), rgb(29, 78, 216)); border-radius: 99px; }

::-webkit-scrollbar-thumb:hover { background: rgb(29, 78, 216); }

body { font-family: Inter, "Noto Sans Bengali", Roboto, system-ui, sans-serif; background: var(--bg); color: var(--tx); min-height: 100vh; -webkit-font-smoothing: antialiased; text-rendering: optimizelegibility; overflow-x: hidden; }

body::before { content: ""; position: fixed; inset: 0px; z-index: -1; pointer-events: none; background-image: radial-gradient(600px 400px at 90% -5%, rgba(37, 99, 235, 0.12), transparent 70%), radial-gradient(500px 500px at -10% 45%, rgba(96, 165, 250, 0.14), transparent 70%); transform: translateZ(0px); will-change: transform; }

a { color: inherit; text-decoration: none; }

svg.i { width: 1em; height: 1em; fill: none; stroke: currentcolor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

svg.f { width: 1em; height: 1em; fill: currentcolor; stroke: none; }

.wrap { max-width: 1000px; margin: 0px auto; padding: 0px 16px; }

.ph { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: rgb(37, 99, 235); text-align: center; background: linear-gradient(110deg, rgb(230, 238, 255) 30%, rgb(244, 248, 255) 50%, rgb(230, 238, 255) 70%) 0px 0px / 200% 100%; animation: 2.4s linear 0s infinite normal none running sh; }

.thumb.ph { animation: auto ease 0s 1 normal none running none; background: rgb(232, 240, 254); }

.ph picture { position: absolute; inset: 0px; width: 100%; height: 100%; display: block; }

.ph img { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block; }

@keyframes sh { 
  100% { background-position: -200% 0px; }
}

header { position: sticky; top: 0px; z-index: 40; background: rgb(255, 255, 255); border-bottom: 1px solid var(--bd); padding-top: env(safe-area-inset-top); }

.hd { display: flex; align-items: center; justify-content: space-between; height: 68px; }

.logo { display: inline-flex; align-items: center; height: 44px; max-width: 145px; }

.logo img { height: 100%; width: auto; max-width: 100%; object-fit: contain; display: block; }

.hr { display: flex; align-items: center; gap: 12px; }

.wallet { display: flex; align-items: center; gap: 8px; height: 42px; padding: 0px 16px 0px 12px; border-radius: 99px; background: var(--g); color: rgb(255, 255, 255); font-weight: 700; font-size: 15px; box-shadow: rgba(37, 99, 235, 0.6) 0px 8px 18px -6px; }

.wallet svg { font-size: 19px; }

.avatar { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; padding: 2px; background: linear-gradient(135deg, rgb(59, 130, 246), rgb(29, 78, 216)); box-shadow: rgba(37, 99, 235, 0.5) 0px 6px 14px -4px; cursor: pointer; transition: 0.2s; }

.avatar:hover { transform: scale(1.05); }

.avatar:active { transform: scale(0.95); }

.avatar .av-inner { width: 100%; height: 100%; border-radius: 50%; background: rgb(239, 246, 255); display: flex; align-items: center; justify-content: center; color: rgb(37, 99, 235); }

.avatar .av-inner svg { width: 21px; height: 21px; stroke-width: 2.2; }

.hero { margin-top: 18px; position: relative; border-radius: 26px; overflow: hidden; border: 1.5px solid rgb(30, 41, 59); box-shadow: rgb(30, 41, 59) 0px 4px 0px, rgba(17, 24, 39, 0.28) 0px 16px 36px -12px; user-select: none; touch-action: pan-y; background: rgb(5, 13, 36); cursor: grab; transform: translateZ(0px); }

.hero:active { cursor: grabbing; }

.track { display: flex; width: 100%; will-change: transform; backface-visibility: hidden; transform: translateZ(0px); }

.slide { flex: 0 0 100%; width: 100%; min-width: 100%; position: relative; aspect-ratio: 2 / 1; min-height: 160px; border-radius: 0px; font-size: 15px; overflow: hidden; background: rgb(5, 13, 36); backface-visibility: hidden; }

.slide img { pointer-events: none; -webkit-user-drag: none; user-select: none; width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block; backface-visibility: hidden; }

.dots { position: absolute; left: 0px; right: 0px; bottom: 14px; display: flex; justify-content: center; gap: 7px; z-index: 10; pointer-events: none; }

.dots i { width: 16px; height: 5px; border-radius: 6px; background: rgba(255, 255, 255, 0.45); cursor: pointer; pointer-events: auto; transition: 0.4s cubic-bezier(0.2, 1, 0.3, 1); box-shadow: rgba(0, 0, 0, 0.45) 0px 1px 4px; }

.dots i.on { width: 36px; background: rgb(255, 255, 255); box-shadow: rgba(37, 99, 235, 0.85) 0px 2px 10px, rgba(0, 0, 0, 0.5) 0px 1px 4px; }

.quick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; }

.q { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 8px; border-radius: 16px; background: rgb(255, 255, 255); color: var(--tx); border: 1px solid var(--bd); box-shadow: rgba(20, 40, 90, 0.05) 0px 2px 8px; text-align: center; transition: 0.2s; }

.q:hover { border-color: rgb(147, 197, 253); box-shadow: rgba(37, 99, 235, 0.5) 0px 6px 16px -8px; }

.q:active { transform: scale(0.97); }

.q .ic { width: 28px; height: 28px; border-radius: 50%; background: var(--g); color: rgb(255, 255, 255); display: grid; place-items: center; font-size: 15px; flex-shrink: 0; }

.q small { display: none; }

.q b { font-size: 12.5px; font-weight: 600; white-space: nowrap; }

.sec { display: flex; align-items: center; gap: 12px; margin: 34px 0px 16px; }

.sec::before { content: ""; width: 5px; height: 28px; border-radius: 5px; background: linear-gradient(var(--gold),var(--v)); }

.sec h2 { font-size: 21px; font-weight: 800; letter-spacing: -0.5px; }

.sec h2 em { font-style: normal; background: linear-gradient(90deg, rgb(59, 130, 246), rgb(37, 99, 235)) text; color: transparent; }

.sec::after { content: ""; flex: 1 1 0%; height: 1px; background: linear-gradient(90deg,var(--bd),transparent); }

.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }

.card { position: relative; border-radius: 20px; overflow: hidden; background: rgb(255, 255, 255); border: 1.8px solid rgb(17, 24, 39); box-shadow: rgb(17, 24, 39) 0px 5px 0px, rgba(17, 24, 39, 0.26) 0px 10px 20px -3px; transition: 0.25s cubic-bezier(0.2, 1, 0.3, 1); transform: translateZ(0px); backface-visibility: hidden; contain: layout paint; }

.card::before { content: ""; position: absolute; inset: 0px; border-radius: inherit; padding: 1px; background: linear-gradient(160deg, rgba(155, 108, 255, 0.9), transparent 55%); mask: linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px) content-box exclude, linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px); opacity: 0; transition: 0.3s; pointer-events: none; z-index: 2; will-change: opacity; }

.card:hover { transform: translateY(-4px); box-shadow: rgb(17, 24, 39) 0px 8px 0px, rgba(17, 24, 39, 0.36) 0px 18px 28px -4px; }

.card:hover::before { opacity: 1; }

.card:active { transform: translateY(3px); box-shadow: rgb(17, 24, 39) 0px 2px 0px, rgba(17, 24, 39, 0.25) 0px 6px 12px; }

.thumb { aspect-ratio: 1 / 1; border-radius: 0px; }

.card p { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 50px; padding: 8px 6px; font-size: 11.5px; font-weight: 700; color: rgb(17, 24, 39); text-align: center; text-transform: uppercase; letter-spacing: 0.2px; }

.v-badge { width: 18px; height: 18px; display: inline-block; vertical-align: -3px; margin-left: 4px; flex-shrink: 0; }

.dl { margin-top: 36px; padding: 26px 18px; text-align: center; border-radius: 26px; background: linear-gradient(160deg, rgb(232, 240, 255), rgb(255, 255, 255)); border: 1px solid var(--bd); }

.dl h3 { font-size: 17px; font-weight: 800; letter-spacing: 0.4px; margin-bottom: 16px; }

.play { color: rgb(255, 255, 255); display: inline-flex; align-items: center; gap: 12px; padding: 10px 22px 10px 16px; border-radius: 14px; background: rgb(0, 0, 0); border: 1.5px solid rgb(141, 141, 149); text-align: left; transition: 0.25s; }

.play:hover { transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.5) 0px 10px 26px; }

.play svg { width: 30px; height: 34px; }

.play small { display: block; color: rgb(255, 255, 255); font-size: 10px; font-weight: 500; letter-spacing: 0.6px; }

.play b { display: block; color: rgb(255, 255, 255); font-size: 22px; font-weight: 600; letter-spacing: -0.6px; line-height: 1.05; }

footer { margin-top: 30px; padding: 30px 0px 150px; border-top: 1px solid var(--bd); }

.flogo { width: 104px; height: 42px; border-radius: 8px; }

.ft { margin-top: 20px; font-weight: 700; font-size: 15px; line-height: 1.6; }

.warn { margin-top: 14px; padding: 14px 16px; border-radius: 16px; background: var(--card); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 3px solid var(--gold); color: var(--mu); font-size: 13.5px; line-height: 1.85; }

.warn b { color: var(--tx); }

.tgbtn { display: inline-flex; align-items: center; gap: 12px; margin-top: 16px; padding: 14px 24px 14px 18px; border-radius: 16px; background: var(--g); color: rgb(255, 255, 255); font-weight: 600; box-shadow: rgba(37, 99, 235, 0.8) 0px 10px 22px -10px; }

.tgbtn svg { font-size: 20px; }

footer h2 { margin: 30px 0px 12px; font-size: 26px; font-weight: 800; letter-spacing: -0.6px; }

.help { display: flex; align-items: center; gap: 14px; padding: 18px; border-radius: 20px; background: var(--card); border: 1px solid var(--bd); }

.help .ti { width: 46px; height: 46px; border-radius: 50%; background: rgb(10, 143, 214); display: grid; place-items: center; font-size: 22px; flex-shrink: 0; }

.help h4 { display: flex; align-items: center; gap: 6px; font-size: 16px; }

.help h4 svg { font-size: 19px; color: rgb(59, 130, 246); }

.help p { margin-top: 2px; color: var(--mu); font-size: 14px; }

.copy { margin-top: 26px; text-align: center; color: var(--mu); font-size: 12px; }

.fab { position: fixed; right: 16px; bottom: 90px; z-index: 50; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; padding-bottom: env(safe-area-inset-bottom); }

.fab { pointer-events: none; }

.fb { pointer-events: auto; }

.menu { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; opacity: 0; transform: translateY(14px) scale(0.9); transform-origin: right bottom; pointer-events: none; transition: 0.28s; }

.fab.open .menu { opacity: 1; transform: none; pointer-events: auto; }

.menu a { display: flex; align-items: center; gap: 10px; padding: 6px 6px 6px 16px; border-radius: 99px; background: rgb(255, 255, 255); border: 1px solid var(--bd); box-shadow: rgba(20, 40, 90, 0.15) 0px 8px 20px; font-size: 13px; font-weight: 600; }

.menu a span { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-size: 19px; color: rgb(255, 255, 255); }

.fb { position: relative; width: 60px; height: 60px; border: 0px; border-radius: 50%; background: var(--g); color: rgb(255, 255, 255); font-size: 26px; display: grid; place-items: center; cursor: pointer; box-shadow: rgba(37, 99, 235, 0.18) 0px 0px 0px 6px, rgba(37, 99, 235, 0.08) 0px 0px 0px 14px, rgba(37, 99, 235, 0.8) 0px 14px 26px -8px; }

.fb .x, .fab.open .fb .h { display: none; }

.fab.open .fb .x { display: block; }

.nav { position: fixed; left: 50%; transform: translateX(-50%) translateZ(0px); bottom: calc(6px + env(safe-area-inset-bottom,0px)); width: min(100% - 20px, 520px); height: 68px; z-index: 45; display: grid; grid-template-columns: repeat(5, 1fr); border-radius: 24px; background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(20px); border: 1px solid var(--bd); box-shadow: rgba(20, 40, 100, 0.16) 0px 10px 28px; backface-visibility: hidden; will-change: transform; }

.nav a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: var(--mu); font-size: 10.5px; font-weight: 600; position: relative; transition: 0.2s; }

.nav a svg { font-size: 23px; }

.nav a.on { color: var(--v); }

.nav a.on::after { content: ""; position: absolute; top: 5px; width: 18px; height: 3px; border-radius: 3px; background: var(--v); }

.nav a.add { justify-content: flex-end; padding-bottom: 9px; }

.nav a.add i { position: absolute; top: -22px; width: 58px; height: 58px; border-radius: 50%; background: var(--g); color: rgb(255, 255, 255); display: grid; place-items: center; border: 4px solid rgb(255, 255, 255); box-shadow: rgba(37, 99, 235, 0.8) 0px 10px 22px -4px; }

.nav a.add i svg { font-size: 26px; }

@media (min-width: 760px) {
  .grid { grid-template-columns: repeat(6, 1fr); }
  .slide { aspect-ratio: 2.1 / 1; }
  .nav { display: none !important; }
  .fab { right: max(16px, 50% - 480px); bottom: 24px; }
  footer { padding-bottom: 50px; }
}

@media (prefers-reduced-motion: reduce) {
  * { animation: auto ease 0s 1 normal none running none !important; transition: none !important; }
}

.dl { position: relative; overflow: hidden; margin-top: 24px; padding: 30px 20px 32px; border-radius: 28px; text-align: center; background: linear-gradient(135deg, rgb(59, 130, 246), rgb(29, 78, 216) 55%, rgb(30, 58, 138)); border: 0px; box-shadow: rgba(29, 78, 216, 0.8) 0px 22px 44px -22px; }

.dl::before, .dl::after { content: ""; position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.08); }

.dl::before { width: 200px; height: 200px; right: -60px; top: -80px; }

.dl::after { width: 140px; height: 140px; left: -50px; bottom: -60px; }

.dl > * { position: relative; z-index: 1; }

.dl .pi { width: 48px; height: 48px; border-radius: 15px; background: rgba(255, 255, 255, 0.16); display: grid; place-items: center; margin: 0px auto 12px; font-size: 24px; }

.dl h3 { color: rgb(255, 255, 255); margin-bottom: 16px; }

footer { margin-top: 34px; }

.brand { display: flex; align-items: center; gap: 14px; }

.brand b { display: block; font-size: 17px; font-weight: 800; }

.brand span { display: block; margin-top: 2px; font-size: 13px; color: var(--mu); }

.notes { display: grid; gap: 10px; margin-top: 22px; }

.note { display: flex; gap: 12px; padding: 14px; border-radius: 18px; background: rgb(255, 255, 255); border: 1px solid var(--bd); }

.note .ni { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; font-size: 19px; background: rgb(232, 240, 255); color: var(--v); flex-shrink: 0; }

.note b { font-size: 14px; }

.note p { margin-top: 3px; font-size: 13.5px; line-height: 1.8; color: var(--mu); }

.warn2 { background: rgb(255, 248, 235); border-color: rgb(253, 231, 184); }

.warn2 .ni { background: rgb(253, 233, 189); color: rgb(180, 83, 9); }

.warn2 b { color: rgb(146, 64, 14); }

.help b { display: flex; align-items: center; gap: 6px; font-size: 16px; }

.help b svg { font-size: 19px; color: rgb(59, 130, 246); }

.help p svg { vertical-align: -2px; margin-right: 5px; }

.help .go { margin-left: auto; width: 34px; height: 34px; border-radius: 50%; background: rgb(232, 240, 255); color: var(--v); display: grid; place-items: center; font-size: 17px; flex-shrink: 0; }

.fbtns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }

.fbtn { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 14px; border-radius: 16px; background: var(--g); color: rgb(255, 255, 255); font-weight: 600; box-shadow: rgba(37, 99, 235, 0.8) 0px 10px 22px -10px; }

.fbtn.alt { background: rgb(255, 255, 255); color: var(--v); border: 1px solid rgb(201, 218, 255); box-shadow: none; }

.fbtn svg { font-size: 19px; }

.copy { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--bd); }

footer .about h2 { margin: 0px 0px 6px; font-size: 24px; font-weight: 800; letter-spacing: -0.3px; background: linear-gradient(90deg, rgb(29, 78, 216), rgb(59, 130, 246)) text; color: transparent; }

.about p { font-size: 14px; color: var(--mu); line-height: 1.7; }

.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 0px; }

.chips span { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 99px; background: rgb(255, 255, 255); border: 1px solid var(--bd); font-size: 13px; font-weight: 600; }

.chips svg { font-size: 16px; color: var(--v); }

.pop { position: fixed; inset: 0px; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 20px 20px 46px; background: rgba(10, 22, 55, 0.55); backdrop-filter: blur(7px); opacity: 0; pointer-events: none; transition: opacity 0.3s; }

.pop.show { opacity: 1; pointer-events: auto; }

.pbox { position: relative; width: min(100%, 460px); background: rgb(255, 255, 255); border-radius: 26px; box-shadow: rgba(0, 0, 0, 0.55) 0px 30px 80px -10px; transform: translateY(24px) scale(0.94); transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.15); }

.pop.show .pbox { transform: none; }

.pimg { aspect-ratio: 1.85 / 1; border-radius: 26px 26px 0px 0px; font-size: 14px; }

.pbody { padding: 18px 14px 46px; text-align: center; }

.pbody p { font-size: clamp(13px, 3.8vw, 15.5px); line-height: 1.6; font-weight: 600; color: var(--tx); word-break: keep-all; }

.pbtn { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; padding: 12px 24px; border-radius: 12px; background: var(--g); color: rgb(255, 255, 255); font-weight: 600; box-shadow: rgba(37, 99, 235, 0.9) 0px 10px 22px -10px; }

.pclose { position: absolute; left: 50%; bottom: -27px; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; padding: 14px 32px; border: 0px; border-radius: 99px; background: var(--g); color: rgb(255, 255, 255); font-family: inherit; font-weight: 800; font-size: 16px; line-height: 1; letter-spacing: 0.6px; cursor: pointer; box-shadow: rgba(255, 255, 255, 0.9) 0px 0px 0px 5px, rgba(37, 99, 235, 0.9) 0px 14px 26px -8px; }

.pclose svg { font-size: 16px; stroke-width: 2.6; }

#ffView { padding-bottom: 130px; }

.pv-hero { margin-top: 18px; display: flex; align-items: center; gap: 16px; padding: 14px; border-radius: 24px; background: linear-gradient(135deg, rgb(255, 255, 255), rgb(232, 240, 255)); border: 1px solid var(--bd); box-shadow: rgba(37, 99, 235, 0.45) 0px 10px 26px -14px; position: relative; overflow: hidden; }

.pv-hero::after { content: ""; position: absolute; right: -50px; top: -60px; width: 170px; height: 170px; border-radius: 50%; background: rgba(59, 130, 246, 0.12); }

.pv-img { width: 92px; height: 92px; border-radius: 20px; border: 1px solid var(--bd); background: rgb(255, 255, 255); padding: 5px; flex-shrink: 0; position: relative; z-index: 1; }

.pv-img .thumb { width: 100%; height: 100%; border-radius: 15px; aspect-ratio: auto; }

.pv-info { position: relative; z-index: 1; min-width: 0px; }

.pv-info h1 { font-size: 23px; font-weight: 800; letter-spacing: -0.4px; }

.pv-pill { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; padding: 7px 13px; border-radius: 99px; background: rgb(232, 240, 255); border: 1px solid rgb(201, 218, 255); color: var(--v); font-size: 13px; font-weight: 700; }

.pv-pill svg { width: 15px; height: 15px; fill: rgb(245, 158, 11); stroke: none; }

.pv-back { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; padding: 8px 14px; border: 1px solid var(--bd); border-radius: 99px; background: rgb(255, 255, 255); font-size: 13px; font-weight: 600; color: var(--mu); cursor: pointer; font-family: inherit; }

.pv-back svg { font-size: 15px; transform: rotate(180deg); }

.pv-box { margin-top: 16px; border-radius: 22px; background: rgb(255, 255, 255); border: 1px solid var(--bd); box-shadow: rgba(20, 40, 90, 0.35) 0px 6px 20px -14px; overflow: hidden; }

.pv-head { display: flex; align-items: center; gap: 12px; padding: 16px; border-bottom: 1px solid var(--bd); }

.pv-head .n { width: 34px; height: 34px; border-radius: 50%; background: var(--g); color: rgb(255, 255, 255); font-weight: 800; font-size: 16px; display: grid; place-items: center; flex-shrink: 0; box-shadow: rgba(37, 99, 235, 0.6) 0px 6px 14px -4px; }

.pv-head h2 { font-size: 19px; font-weight: 800; letter-spacing: -0.2px; }

.pv-body { padding: 14px; }

.pk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.pk { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 10px; min-height: 112px; padding: 14px 8px; border-radius: 16px; border: 1.5px solid var(--bd); background: rgb(255, 255, 255); text-align: center; cursor: pointer; font-family: inherit; color: var(--tx); transition: 0.2s; }

.pk:hover { border-color: rgb(147, 197, 253); }

.pk:active { transform: scale(0.97); }

.pk span { font-size: 14px; font-weight: 700; line-height: 1.55; }

.pk b { font-size: 15px; font-weight: 800; color: var(--v); }

.pk.on { border-color: var(--v); background: linear-gradient(160deg, rgb(239, 245, 255), rgb(255, 255, 255)); box-shadow: rgba(37, 99, 235, 0.15) 0px 0px 0px 3px, rgba(37, 99, 235, 0.7) 0px 10px 20px -12px; }

