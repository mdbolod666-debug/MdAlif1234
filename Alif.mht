.acc { position: fixed; inset: 0px; z-index: 44; background: rgba(10, 22, 55, 0.5); opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s; }

.acc.show { opacity: 1; visibility: visible; transition: opacity 0.3s, visibility; }

.acc-in { position: absolute; top: 0px; right: 0px; bottom: 0px; width: 64%; max-width: 340px; display: flex; flex-direction: column; background: rgb(255, 255, 255); box-shadow: rgba(10, 22, 55, 0.35) -12px 0px 36px -10px; transform: translateX(100%); transition: transform 0.38s cubic-bezier(0.2, 1, 0.3, 1); overflow-y: auto; padding-bottom: calc(100px + env(safe-area-inset-bottom,0px)); }

.acc.show .acc-in { transform: none; }

.acc-top { position: relative; display: flex; flex-direction: column; align-items: center; padding: calc(14px + env(safe-area-inset-top,0px)) 12px 14px; background: rgb(255, 255, 255); border-bottom: 1px solid var(--bd); }

.acc-x { display: none; }

.acc-user { display: flex; align-items: center; gap: 10px; width: 100%; }

.acc-av { width: 52px; height: 52px; border-radius: 14px; padding: 2.5px; background: var(--g); box-shadow: rgba(37, 99, 235, 0.6) 0px 6px 14px -6px; flex-shrink: 0; }

.acc-av div { width: 100%; height: 100%; border-radius: 11.5px; overflow: hidden; background: rgb(239, 246, 255); display: grid; place-items: center; color: var(--v); font-size: 24px; }

.acc-av img { width: 100%; height: 100%; object-fit: cover; display: block; }

.acc-nm { min-width: 0px; flex: 1 1 0%; }

.acc-nm b { display: block; font-size: 15px; font-weight: 800; letter-spacing: -0.2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.acc-nm span { display: block; margin-top: 2px; font-size: 12px; color: var(--mu); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.acc-lo { display: inline-flex; align-items: center; gap: 7px; margin-top: 12px; padding: 8px 18px; border: 0px; border-radius: 10px; background: var(--g); color: rgb(255, 255, 255); font-family: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer; box-shadow: rgba(37, 99, 235, 0.85) 0px 8px 18px -8px; transition: 0.2s; }

.acc-lo:active { transform: scale(0.97); }

.acc-lo svg { font-size: 16px; stroke-width: 2.2; }

.acc-list { background: rgb(255, 255, 255); border-bottom: 1px solid var(--bd); }

.acc-it { display: flex; align-items: center; gap: 13px; padding: 14px; font-size: 14.5px; font-weight: 700; color: var(--tx); transition: 0.15s; }

.acc-it svg { font-size: 22px; color: rgb(30, 41, 59); flex-shrink: 0; }

.acc-it:active { background: rgb(239, 245, 255); }

.acc-it.on { color: var(--v); }

.acc-it.on svg { color: var(--v); }

.acc-sup { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 14px auto 0px; padding: 11px 26px; border-radius: 12px; background: var(--g); color: rgb(255, 255, 255); font-size: 14.5px; font-weight: 700; box-shadow: rgba(37, 99, 235, 0.8) 0px 10px 20px -10px; }

.acc-sup svg { font-size: 19px; }

.acc-sup:active { transform: scale(0.97); }

